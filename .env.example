# Copia este archivo como .env y completa los valores (Supabase > Connect o Settings > API Keys).
# La publishable key es segura en el navegador porque el acceso a los datos lo restringe RLS.
# Nunca pongas aquí una clave secret ni service_role: se empaquetaría en el JavaScript público.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clave anon legada (en desuso a finales de 2026). Solo se usa como respaldo si falta la publishable.
# VITE_SUPABASE_ANON_KEY=
